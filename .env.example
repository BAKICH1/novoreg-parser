# === ХОСТИНГ HERE.NOW ===
HERENOW_SLUG=vivid-quill-yz5r
# Получите постоянный API-ключ после привязки сайта по claimUrl в https://here.now/dashboard
HERENOW_API_KEY=
HERENOW_AUTO_PUBLISH=true

# === КОНТУР 2 (ПОДКЛЮЧАЕМЫЕ API КОНТРАГЕНТОВ И СПРАВОЧНИКОВ — ОПЦИОНАЛЬНО) ===
# DaData.ru — до 10 000 запросов в сутки бесплатно (ИП + ООО по дате регистрации)
DADATA_API_KEY=
# Checko.ru — до 100 запросов в сутки бесплатно (ИП + ООО + официальные телефоны/email)
CHECKO_API_KEY=
# 2ГИС Catalog API — автопоиск рабочих телефонов, WhatsApp и Telegram по названию и городу
TWOGIS_API_KEY=
# API-ФНС (api-fns.ru) — прямые выборки с фильтром only_phone
APIFNS_KEY=

# === ДОПОЛНИТЕЛЬНЫЕ НАСТРОЙКИ ===
# Российский HTTP/HTTPS прокси (опционально — включает прямой опрос egrul.nalog.ru из GitHub Actions)
RU_PROXY_URL=
# Сохранять строго только карточки с найденным телефоном (true / false)
ONLY_WITH_PHONE=false
